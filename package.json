{
  "name": "kite-algo-trading",
  "version": "1.0.0",
  "description": "Algorithmic trading platform using Zerodha Kite Connect API",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "client": "cd client && npm start",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "create-profile": "node create-profile.js"
  },
  "keywords": ["zerodha", "kite", "algo-trading", "trading-bot"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "kiteconnect": "^5.1.0",
    "ws": "^8.14.2",
    "mongoose": "^7.6.3",
    "socket.io": "^4.7.2",
    "node-cron": "^3.0.2",
    "axios": "^1.5.1",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1"
  }
}
