# Demo Mode - Set to true to test without Kite API credentials
DEMO_MODE=false
DEMO_MODE_DB=true

# Zerodha Kite Connect API Configuration
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=
# Note: Leave KITE_ACCESS_TOKEN empty - it will be auto-generated via OAuth flow
#       Access at http://localhost:5000/auth.html to authenticate

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/kite-algo-trading

# WebSocket Configuration
WS_RECONNECT_INTERVAL=5000
MAX_RECONNECT_ATTEMPTS=10

# Trading Configuration
ENABLE_AUTO_TRADING=false
MAX_POSITIONS=5
MAX_ORDER_VALUE=50000
RISK_PER_TRADE=0.02

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
